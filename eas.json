{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "smoke": {
      "withoutCredentials": true,
      "ios": {
        "config": "smoke.yml",
        "image": "latest"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "config": "ios.yml",
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "PLACEHOLDER_REPLACE_WITH_APP_STORE_CONNECT_APP_ID"
      }
    }
  }
}
